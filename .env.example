DATABASE_PATH=data/threatintel.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_SEVERITY=high
USER_AGENT=mini-threat-intel/0.1 (+https://github.com/silvance/darkwebassess)

# Enrichment provider keys (all optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ABUSECH_AUTH_KEY=
ENRICHMENT_MAX_AGE_HOURS=168

# Self-monitoring "scrub" (dwa scrub). All optional.
# HIBP breach API key (paid) — when empty the HIBP provider self-skips.
HIBP_API_KEY=
# SCRUB_HTTP_TIMEOUT=15
# SCRUB_REQUEST_DELAY=0.5

# Phase 6 scoring
SUPPRESSION_PATH=suppression.yaml
ALERT_MIN_SCORE=0

# Phase 8 scheduler intervals
COLLECT_INTERVAL_MINUTES=30
ENRICH_INTERVAL_MINUTES=15
ENRICH_BATCH_LIMIT=100
SOURCE_HEALTH_INTERVAL_HOURS=12
SOURCE_BACKOFF_BASE_MINUTES=5
SOURCE_BACKOFF_MAX_EXPONENT=6

# Phase 11 LLM summaries
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-7
LLM_MAX_TOKENS=2048
LLM_DOC_TEXT_CHARS=12000

# Phase 13 reporting
DAILY_REPORT_INTERVAL_HOURS=0

# Phase 14 hardening — set AUTH_ENABLED=1 in production deployments.
# When AUTH_ENABLED=0 the dashboard is wide open (single-user mode).
AUTH_ENABLED=0
# Friendly identity used in audit rows when AUTH_ENABLED=0.
AUTH_DEFAULT_USER=local
