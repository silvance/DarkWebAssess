TELEGRAM_CHAT_ID=
ALERT_MIN_SEVERITY=high
USER_AGENT=mini-threat-intel/0.1 (+https://github.com/silvance/darkwebassess)

# Enrichment provider keys (all optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ABUSECH_AUTH_KEY=
